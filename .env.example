# ElevenLabs — Conversational AI + Twilio outbound calling
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Gemini — structured call notes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tavily — pre-call hotel research (optional; leave blank to skip gracefully)
TAVILY_API_KEY=

# live = real outbound phone call | mock = scripted transcript, no external calls
CALL_MODE=mock
