# Vapi — outbound calling + assistant (voice provider is ElevenLabs, configured in the Vapi dashboard)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# OpenAI — structured call notes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Tavily — pre-call hotel research (optional; leave blank to skip gracefully)
TAVILY_API_KEY=

# live = real outbound phone call | mock = scripted transcript, no external calls
CALL_MODE=mock
